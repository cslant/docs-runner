#SOURCE_DIR=~/source
SOURCE_DIR=/home/user/docs.cslant.com

GIT_SSH_URL=git@github.com:cslant

# REPO: cslant/docs.git
DOCS_REPO=docs

# DOCS_NAME=docusaurus-docs
DOCS_NAME=main-docs

# The name of the runner
# E.g: CSlant Docs
# Need to match the name of the ecosystem.config.cjs file
WORKER_NAME="CSlant Docs"

# add the env to choose "npm" or "yarn" as the installer
INSTALLER=yarn
#PORT=3000

# App Config
# E.g: prod, dev
ENV=prod

USE_SUBMODULES=false

# ASSETS CONFIG
SSH_NAME=cslant_server_target
SSH_DOCS_PATH=/var/www/html/docs.cslant.com

# Atomic deploy layout (nginx root must point at $SSH_DOCS_PATH/current):
#   $SSH_DOCS_PATH/current -> ../docs.cslant.com-releases/<ts>-<sha>   (live symlink)
#   $SSH_DOCS_PATH-releases/<ts>-<sha>/                                (each deploy = fresh dir)
# Optional, sensible defaults are applied by setup/variables.sh:
#SSH_RELEASES_DIR=/var/www/html/docs.cslant.com-releases
#SSH_LIVE_NAME=current
#KEEP_RELEASES=5
#DOCS_PUBLIC_URL=https://docs.cslant.com
#PREWARM_MAX=80
